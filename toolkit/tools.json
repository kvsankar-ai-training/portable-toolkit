      "sha256": "56d7b226b7693196cfc71fef26568f536c4a021ab6c37ff2db4287bed908e96e",
      "sha256_source": "https://github.com/git-for-windows/git/releases/tag/v2.55.0.windows.5",
      "target": "git",
      "strip_root": false,
      "path_add": "git/cmd",
      "verify": ["git/cmd/git.exe", "--version"]
    }
  ],

  "python": {
    "version": "3.13",
    "environment": "env",
    "packages": []
  }
