      "target": "uv",
      "strip_root": false,
      "path_add": "uv",
      "verify": ["uv/uv.exe", "--version"]
    },
    {
      "name": "node",
      "version": "24.21.0",
      "url": "https://nodejs.org/dist/v24.21.0/node-v24.21.0-win-x64.zip",
      "sha256": "158f7685b44de51f6c0df1d153526cbcd3e1bc739a8dfc607721cef75de9e541",
      "sha256_source": "https://nodejs.org/dist/v24.21.0/SHASUMS256.txt",
